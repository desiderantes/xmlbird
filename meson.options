option(
  'tests',
  type: 'boolean',
  value: true,
  description: 'Build tests and benchmarks',
)

option(
  'fuzzing',
  type: 'boolean',
  value: false,
  description: 'Build fuzzing target',
)

option(
  'fuzz_duration',
  type: 'integer',
  min: 0,
  value: 0,
  description: 'Duration in seconds for the AFL++ fuzz target (0 runs until interrupted)',
)

option(
  'experimental_non_null',
  type: 'boolean',
  value: false,
  description: 'Enable compile-time checks for null pointers',
)
